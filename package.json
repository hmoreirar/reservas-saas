{
  "name": "reservas-saas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cd frontend && npm install && npm run build",
    "start": "cd backend && node dist/server.js",
    "dev": "cd backend && npx tsx watch src/server.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "test": "cd backend && npx vitest run",
    "test:watch": "cd backend && npx vitest",
    "typecheck": "cd backend && npx tsc --noEmit"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "googleapis": "^128.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^6.9.8",
    "pg": "^8.20.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
