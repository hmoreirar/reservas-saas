{
  "name": "reservas-saas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "packages/shared"
  ],
  "scripts": {
    "build": "npm run build -w frontend && cd backend && npm install && npm run build",
    "start": "cd backend && node dist/server.js",
    "dev": "cd backend && npx tsx watch src/server.ts",
    "dev:frontend": "npm run dev -w frontend",
    "test": "cd backend && npx vitest run",
    "test:frontend": "npm test -w frontend",
    "test:watch": "cd backend && npx vitest",
    "typecheck": "cd backend && npx tsc --noEmit",
    "typecheck:frontend": "npm run typecheck -w frontend",
    "lint:frontend": "npm run lint -w frontend",
    "e2e:serve": "npm run build -w frontend && cd backend && npx tsx src/server.ts",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0"
  }
}
